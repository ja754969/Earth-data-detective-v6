# Copy to .env locally. Do not commit the resulting file.
# Exact HTTPS hostnames only; no wildcards, paths, credentials, or tokens.
ALLOWED_DOMAINS=data.nas.nasa.gov,cmr.earthdata.nasa.gov,data.gesdisc.earthdata.nasa.gov,goldsmr4.gesdisc.eosdis.nasa.gov,planetarycomputer.microsoft.com
EARTHDATA_AUTH_STRATEGY=netrc
AZURE_AUTH_MODE=default_credential
# Optional compatibility settings for the legacy ECCO-Darwin viewer.
ECCO_FLUX_URL=https://data.nas.nasa.gov/ecco/llc_270/ecco_darwin_v5/output/monthly/CO2_flux/
ECCO_GRID_URL=https://data.nas.nasa.gov/ecco/llc_270/grid/
ECCO_REF_DATETIME=1992-01-01T00:00:00+00:00
ECCO_DT_SECONDS=1200
ECCO_START_DATE=1992-01-01T00:00:00+00:00
ECCO_END_DATE=2011-12-31T00:00:00+00:00
ECCO_MIN_LON=-180
ECCO_MAX_LON=180
ECCO_MIN_LAT=-90
ECCO_MAX_LAT=90
# GCP_PROJECT_ID=your-project-id
# GEE_PROJECT=your-project-id
# EE_OPT_URL=https://earthengine-highvolume.googleapis.com
